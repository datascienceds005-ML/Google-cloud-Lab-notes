# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name
DB_PORT=3306

# --- Auth ---
SECRET_KEY=replace-with-a-long-random-string   # must match the same secret server.js used, if tokens need to stay valid across both backends

# --- Server ---
PORT=3006
NODE_ENV=development

# --- Mail (optional — only needed once notification-triggering routes send email) ---
HR_EMAIL=hr.interns.innerwhispers@gmail.com
SMTP_FROM="InnerWhispers Wellness LLP" <no-reply@innerwhispers.in>
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=b0cea3001@smtp-brevo.com

# --- Cloudinary (optional — only needed once file-upload routes are converted) ---
CLOUDINARY_CLOUDNAME=
CLOUDINARY_API=
CLOUDINARY_APISEC=
